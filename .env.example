# Environment variables for RailBusAtithi
# Copy to .env and fill in your values

SECRET_KEY=your_super_secure_random_secret_key_here_make_it_long_and_random
DATABASE_URL=sqlite:///instance/database.db

# For production (e.g. PostgreSQL on Render/Heroku)
# DATABASE_URL=postgresql://user:pass@host/dbname

# Optional: Upload folder (relative)
# UPLOAD_FOLDER=static/uploads

